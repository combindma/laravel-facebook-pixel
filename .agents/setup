#!/usr/bin/env bash
set -euo pipefail

packages=(php8.5-cli php8.5-curl php8.5-mbstring php8.5-xml php8.5-zip php8.5-sqlite3 php8.5-bcmath php8.5-intl unzip)
missing=()
for package in "${packages[@]}"; do
    if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != 'install ok installed' ]]; then
        missing+=("$package")
    fi
done

if ((${#missing[@]})); then
    echo 'Installing PHP 8.5 and test extensions'
    if [[ ! -f /usr/share/keyrings/debsuryorg-archive-keyring.gpg ]]; then
        keyring=$(mktemp --suffix=.deb)
        curl -fsSL https://packages.sury.org/debsuryorg-archive-keyring.deb -o "$keyring"
        sudo dpkg -i "$keyring"
        rm -f "$keyring"
    fi
    printf 'deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ %s main\n' "$(lsb_release -sc)" | sudo tee /etc/apt/sources.list.d/php.list >/dev/null
    sudo apt-get update -qq
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi

if ! command -v composer >/dev/null; then
    echo 'Installing Composer'
    installer=$(mktemp)
    curl -fsSL https://getcomposer.org/installer -o "$installer"
    expected=$(curl -fsSL https://composer.github.io/installer.sig)
    actual=$(php8.5 -r 'echo hash_file("sha384", $argv[1]);' "$installer")
    [[ "$actual" == "$expected" ]] || { rm -f "$installer"; echo 'Composer installer checksum mismatch' >&2; exit 1; }
    php8.5 "$installer" --install-dir=/tmp --filename=composer-orb
    sudo install -m 755 /tmp/composer-orb /usr/local/bin/composer
    rm -f "$installer" /tmp/composer-orb
fi

echo 'Installing package dependencies'
composer install --prefer-dist --no-interaction
